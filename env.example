# Local: development. Vercel also detects production automatically.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SITE_URL=http://localhost:5000
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Never include this value in HTML, JavaScript or a public variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
# Optional legacy aliases: SUPABASE_SERVICE_KEY, SUPABASE_KEY, SUPABASE_ANON_KEY.
# RLS denies browser access; an anon key alone cannot operate the fully migrated app.
# Legacy deployments can boot with SUPABASE_ANON_KEY while migrating, but use the service-role key before applying RLS-hardening.
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared Redis is recommended in production. If omitted, the app falls back to per-instance memory limiting.
# Example production value: rediss://default:password@host:6379
RATELIMIT_STORAGE_URI=memory://
# Optional: seconds to cache public settings/catalogue in each warm worker (0 disables).
PUBLIC_CACHE_TTL=30
