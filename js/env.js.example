// ============================================
// EVERBLOOM — Environment Configuration
// ============================================
// INSTRUCTIONS:
//   1. Copy this file and rename it to env.js (it already is)
//   2. Replace all placeholder values below with your real credentials
//   3. NEVER commit real credentials to Git — add env.js to .gitignore
//      OR use a build tool / hosting platform env vars (see README)
//
// For Netlify/Vercel: set these as environment variables in the dashboard
// and use a build script to inject them. See README.md for details.
// ============================================

window.ENV = {
  // ── Supabase ─────────────────────────────
  // Found in: Supabase Dashboard → Settings → API
  SUPABASE_URL: 'YOUR_SUPABASE_URL',
  SUPABASE_ANON_KEY: 'YOUR_SUPABASE_ANON_KEY',

  // ── Store Info ───────────────────────────
  SITE_URL: 'http://localhost:3000',   // Change to your live domain
  STORE_NAME: 'Everbloom',

  // ── Payment ──────────────────────────────
  // Your UPI ID shown on checkout page
  UPI_ID: 'yourname@upi',

  // Path to your UPI QR code image (put it in /assets/qr-code.png)
  QR_CODE_IMAGE: 'assets/qr-code.png',
};

// ── Runtime validation ───────────────────
(function checkEnv() {
  const required = ['SUPABASE_URL', 'SUPABASE_ANON_KEY'];
  const missing = required.filter(k => !window.ENV[k] || window.ENV[k].startsWith('YOUR_'));
  if (missing.length > 0) {
    console.error(
      '%c⚠ Everbloom: Missing environment variables: ' + missing.join(', '),
      'color: #C0614A; font-weight: bold; font-size: 14px'
    );
    console.info('Edit js/env.js and replace the placeholder values.');
  }
})();
